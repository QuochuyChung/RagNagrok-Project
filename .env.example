# ─────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# Gateway
APP_NAME=Multi-Tenant-RAG-API-Gateway
APP_VERSION=0.2.0
GATEWAY_PORT=8000
DEBUG_MODE=false
LOG_LEVEL=INFO

# UI
UI_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
VITE_DEFAULT_TENANT=dev

# PostgreSQL (Sprint 2)
POSTGRES_USER=ragnarok
POSTGRES_PASSWORD=ragnarok_secret
POSTGRES_DB=rag_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# Qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_URL=
QDRANT_API_KEY=your-qdrant-api-key

# Ollama
OLLAMA_PORT=11434
OLLAMA_HOST=127.0.0.1
LLM_MODEL=qwen3:4b
EMBEDDING_MODEL=qwen3-embedding:0.6b

GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_MODEL=gemini-3.5-flash-lite

CLASSIFY_PROVIDER=ollama
MODEL_RERANKER=BAAI/bge-reranker-v2-m3
COHERE_TRIAL_KEY=your-cohere-trial-key

# RAG ingestion
RAG_VECTOR_SIZE=1024

# Document service
DOCUMENT_ALLOWED_EXTENSIONS=[".pdf", ".txt", ".md", ".docx", ".zip"]
DOCUMENT_STORAGE_ROOT=storage/documents

# Ingestion
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
MAX_CHUNK_CHARS=2048
CHUNK_OVERLAP_CHARS=256
TXT_CHUNK_WORDS=500
TXT_OVERLAP_RATIO=0.15
MAX_UPLOAD_SIZE_MB=10

# Chat
MAX_CONVERSATION_TURNS=20
CONVERSATION_TTL_SECONDS=3600

# SMTP / Email (for invitation emails)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=noreply@ragnarok.local
SMTP_FROM_NAME=Ragnarok Platform

# Real Email
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-gmail-app-password
# SMTP_USE_TLS=True
# SMTP_FROM_NAME="Ragnarok Platform"
# SMTP_FROM_EMAIL=your-email@gmail.com

# JWT Settings
JWT_SECRET_KEY=change-secret-key-in-production-secret-32bytes

# Invitation settings
INVITE_TOKEN_EXPIRE_HOURS=48
# Frontend URL used to build clickable invite links
FRONTEND_BASE_URL=http://localhost:5173

# aws
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=ragnarok-documents-dev
